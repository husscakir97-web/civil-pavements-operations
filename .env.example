# Runtime: set these in Hostinger Environment Variables. Never commit values.
NODE_ENV=production
# Optional: seed only the first signup organisation; set before first signup.
SEED_DEMO_DATA=false
BETTER_AUTH_URL=
BETTER_AUTH_SECRET=
MYSQL_HOST=
MYSQL_PORT=3306
MYSQL_DATABASE=u840559204_infrastruct
MYSQL_USER=u840559204_infra_app
MYSQL_PASSWORD=
# Optional PEM CA certificate, only when the database endpoint supports TLS.
MYSQL_SSL_CA=
R2_ENDPOINT=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=
# Set false to launch without SMTP, email verification, invites or password reset.
EMAIL_ENABLED=true
SMTP_HOST=
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM=
# Optional paid AI features; leave unset to keep them disabled.
OPENAI_API_KEY=
OPENAI_DOCUMENT_MODEL=
# Optional: Hostinger normally supplies PORT; next start honors it.
# PORT=3000
# Local export only. Do NOT add these to the hosted application.
CLOUDFLARE_ACCOUNT_ID=
D1_DATABASE_ID=
CLOUDFLARE_API_TOKEN=
# One-time local organisation attachment only; use IDs, not email matching.
MIGRATION_ADMIN_USER_ID=
MIGRATION_ORGANISATION_ID=
