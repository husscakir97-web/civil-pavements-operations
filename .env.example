# Runtime: set these in Hostinger Environment Variables. Never commit values.
NODE_ENV=production
# Optional: seed only the first signup organisation; set before first signup.
SEED_DEMO_DATA=false
BETTER_AUTH_URL=
BETTER_AUTH_SECRET=
MYSQL_HOST=
MYSQL_PORT=3306
MYSQL_DATABASE=u840559204_infrastruct
MYSQL_USER=u840559204_infra_app
MYSQL_PASSWORD=
# Optional PEM CA certificate, only when the database endpoint supports TLS.
MYSQL_SSL_CA=
R2_ENDPOINT=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=
# Set false to launch without SMTP, email verification, invites or password reset.
EMAIL_ENABLED=true
SMTP_HOST=
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM=
# AI assistance (off unless ALL are set AND an organisation admin switches it on
# AND the organisation holds the `ai` module). A key alone never enables AI.
AI_ENABLED=false
# anthropic | openai
AI_PROVIDER=
AI_API_KEY=
AI_MODEL=
# Optional provider base URL override (e.g. a regional endpoint or gateway).
AI_BASE_URL=
# Legacy variables: no longer enable anything on their own.
OPENAI_API_KEY=
OPENAI_DOCUMENT_MODEL=
# Official ABN Lookup (Australian Business Register) web-services GUID. Unset = lookups
# report "not configured"; ABN checksum validation always works.
ABR_GUID=
# Optional override of https://abr.business.gov.au/json/
ABR_BASE_URL=
# Billing provider webhooks (normalised event format; see lib/platform/billing.ts).
# Unset = no provider connected; organisations stay on the beta trial.
BILLING_PROVIDER=
BILLING_WEBHOOK_SECRET=
# Comma-separated emails of platform operators allowed to record manual subscriptions.
PLATFORM_OPERATOR_EMAILS=
# Optional: Hostinger normally supplies PORT; next start honors it.
# PORT=3000
# Local export only. Do NOT add these to the hosted application.
CLOUDFLARE_ACCOUNT_ID=
D1_DATABASE_ID=
CLOUDFLARE_API_TOKEN=
# One-time local organisation attachment only; use IDs, not email matching.
MIGRATION_ADMIN_USER_ID=
MIGRATION_ORGANISATION_ID=
